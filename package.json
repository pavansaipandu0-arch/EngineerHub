{
  "name": "engineerhub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run check -w server",
    "lint": "eslint client/src server/src",
    "test": "npm run test -w client && npm run test -w server",
    "deploy:smoke": "node scripts/checkDeployment.js",
    "build:production": "node scripts/checkProductionApiUrl.js && npm run build -w client && npm run check -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run start -w server",
    "seed:admin": "npm run seed:admin -w server"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.17.0",
    "browserslist": "^4.29.5",
    "caniuse-lite": "^1.0.30001820",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.4.2",
    "vite": "^6.4.5"
  }
}
